# ==============================================================================
# FileConverter Pro Frontend - Environment Variables
# ==============================================================================

# API Base URL (Points to the backend Nginx API Gateway)
# In Local Dev: http://localhost:80/api/v1
# In Production (Render): https://fileconverter-backend-api.onrender.com/api/v1
NEXT_PUBLIC_API_URL=https://fileconverter-backend-api.onrender.com/api/v1

# Frontend Public Site URL
# In Local Dev: http://localhost:8080
# In Production: https://fileconverter-frontend-fawn.vercel.app
NEXT_PUBLIC_SITE_URL=https://fileconverter-frontend-fawn.vercel.app

# Google OAuth (Optional)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=466195313627-mf3t35danp4mqqq4d5vq8h6k2qdpclql.apps.googleusercontent.com
GOOGLE_CLIENT_ID=466195313627-mf3t35danp4mqqq4d5vq8h6k2qdpclql.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=
